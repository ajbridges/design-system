{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["registry/lib/*"],
      "@/components/ui/*": ["registry/ui/*"],
      "@/hooks/*": ["registry/hooks/*"]
    }
  },
  "include": ["registry"]
}
