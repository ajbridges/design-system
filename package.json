{
  "name": "design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit && tsc -p showcase --noEmit",
    "lint": "eslint registry showcase",
    "validate": "shadcn registry validate ajbridges/design-system",
    "check:ds": "node scripts/check-design-system.mjs registry showcase",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run tokens && npm run typecheck && npm run lint && npm run check:ds && npm run check:contrast"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "culori": "^4.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6"
  }
}
